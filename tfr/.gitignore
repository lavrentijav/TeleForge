# Артефакты сборки. Коммитится только исходник, `Cargo.lock` — тоже коммитится
# (это бинарник: воспроизводимость важнее, чем «свежие» минорные версии).
/target
**/*.rs.bk

# Ключи и сертификаты никогда не должны оказаться в индексе, даже тестовые:
# один случайный `git add -A` — и приватный ключ в истории.
identity/
*.pem
*.key
*.seed
!docs/**/*.pem
