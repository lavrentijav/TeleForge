# Maintainer: TeleForge <lavrentijav@gmail.com>
# Prebuilt package: downloads the ready binary bundle from GitHub Releases.
# Regenerate .SRCINFO with `makepkg --printsrcinfo > .SRCINFO` before pushing to AUR.

pkgname=teleforge-bin
pkgver=6.9.0
pkgrel=1
pkgdesc='TeleForge Desktop messenger, prebuilt binary release'
arch=('x86_64' 'aarch64')
url='https://github.com/lavrentijav/TeleForge'
license=('GPL-3.0-or-later')
provides=('teleforge' 'telegram-desktop')
conflicts=('teleforge' 'teleforge-git' 'telegram-desktop' 'telegram-desktop-bin')
options=('!strip' '!debug')

# Runtime libraries of the release binary (Qt and the C++ runtime are linked
# statically, so no qt6-* packages are needed here).
depends=(
  bzip2
  cairo
  expat
  fontconfig
  freetype2
  fribidi
  glib2
  glibc
  graphite
  harfbuzz
  hicolor-icon-theme
  libbrotli
  libpng
  libselinux
  libthai
  libx11
  libxcb
  pango
  pcre2
  pixman
  util-linux-libs
  xdg-utils
  zlib
)

optdepends=(
  'xdg-desktop-portal: desktop integration'
  'webkit2gtk-4.1: embedded browser features'
)

case "$CARCH" in
  x86_64) _artifact_arch='x86_64' ;;
  aarch64) _artifact_arch='aarch64' ;;
  *) _artifact_arch="$CARCH" ;;
esac

source=("TeleForge-${pkgver}-${_artifact_arch}.tar.xz::https://github.com/lavrentijav/TeleForge/releases/download/v${pkgver}/TeleForge-${pkgver}-${_artifact_arch}.tar.xz")
sha256sums_x86_64=('48482a63c773d63b00c62d18794b60b159264442b0aef883cb8ff2dca046880c')
# No aarch64 release artifact exists yet; replace SKIP with its checksum when
# one is published.
sha256sums_aarch64=('SKIP')

package() {
  # The release tarball is a plain DESTDIR tree rooted at usr/, not a folder
  # with the executable at the top: usr/bin/TeleForge plus
  # usr/share/{applications,dbus-1,icons,metainfo}.
  cp -a "$srcdir/usr/." "$pkgdir/usr/"

  chmod 755 "$pkgdir/usr/bin/TeleForge"
}
