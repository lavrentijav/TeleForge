# Maintainer: TeleForge <lavrentijav@gmail.com>
# Prebuilt package: downloads the ready binary bundle from GitHub Releases.
# Regenerate .SRCINFO with `makepkg --printsrcinfo > .SRCINFO` before pushing to AUR.

pkgname=teleforge-bin
pkgver=6.9.0
pkgrel=1
pkgdesc='TeleForge Desktop messenger, prebuilt binary release'
arch=('x86_64' 'aarch64')
url='https://github.com/lavrentijav/TeleForge'
license=('GPL-3.0-or-later')
provides=('teleforge' 'telegram-desktop')
conflicts=('teleforge' 'teleforge-git' 'telegram-desktop' 'telegram-desktop-bin')
options=('!strip' '!debug')

depends=(
  gcc-libs
  glib2
  glibc
  hicolor-icon-theme
  openssl
  qt6-base
  qt6-imageformats
  qt6-svg
  qt6-wayland
  xdg-utils
  zlib
)

optdepends=(
  'xdg-desktop-portal: desktop integration'
  'webkit2gtk-4.1: embedded browser features'
)

case "$CARCH" in
  x86_64) _artifact_arch='x86_64' ;;
  aarch64) _artifact_arch='aarch64' ;;
  *) _artifact_arch="$CARCH" ;;
esac

source=("TeleForge-${pkgver}-${_artifact_arch}.tar.xz::https://github.com/lavrentijav/TeleForge/releases/download/v${pkgver}/TeleForge-${pkgver}-${_artifact_arch}.tar.xz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/TeleForge"

  install -Dm755 TeleForge "$pkgdir/usr/bin/teleforge"

  install -Dm644 com.teleforge.desktop.desktop \
    "$pkgdir/usr/share/applications/com.teleforge.desktop.desktop"
  install -Dm644 com.teleforge.desktop.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.teleforge.desktop.metainfo.xml"

  for _icon in 16 32 64 128 256 512; do
    if [[ -f "icons/${_icon}.png" ]]; then
      install -Dm644 "icons/${_icon}.png" \
        "$pkgdir/usr/share/icons/hicolor/${_icon}x${_icon}/apps/com.teleforge.desktop.png"
    fi
  done

  for _mono in tray_monochrome tray_monochrome_attention tray_monochrome_mute; do
    if [[ -f "icons/${_mono}.svg" ]]; then
      install -Dm644 "icons/${_mono}.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/com.teleforge.desktop-${_mono#tray_monochrome}.svg"
    fi
  done

  install -Dm644 com.teleforge.desktop.service \
    "$pkgdir/usr/share/dbus-1/services/com.teleforge.desktop.service"

  if [[ -d lib ]]; then
    install -d "$pkgdir/usr/lib/teleforge"
    cp -a lib/. "$pkgdir/usr/lib/teleforge/"
  fi
}
