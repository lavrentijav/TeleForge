using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "dialogs/dialogs.style";

ayuGhostIcon: icon {{ "tf/ghost", menuIconColor }};
ayuEditsHistoryIcon: icon {{ "tf/edits_history", menuIconColor }};
ayuLReadMenuIcon: icon {{ "tf/lread", menuIconColor }};
ayuSReadMenuIcon: icon {{ "tf/sread", menuIconColor }};
ayuStreamerModeMenuIcon: icon {{ "tf/streamer", menuIconColor }};
ayuToBeginningMenuIcon: icon {{ "tf/to_beginning", menuIconColor }};
ayuRepeatMenuIcon: icon {{ "tf/repeat", menuIconColor }};

messageFieldAttachIcon: icon {{ "tf/message_field/attach", menuIconColor }};
messageFieldCommandsIcon: icon {{ "tf/message_field/commands", menuIconColor }};
messageFieldEmojiIcon: icon {{ "tf/message_field/emoji", menuIconColor }};
messageFieldVoiceIcon: icon {{ "tf/message_field/voice", menuIconColor }};
messageFieldTTLIcon: icon {{ "tf/message_field/ttl", menuIconColor }};

inChannelBadgeIcon: icon {{ "tf/channel", msgInDateFg }};
inChannelBadgeSelectedIcon: icon {{ "tf/channel", msgInDateFgSelected }};
outChannelBadgeIcon: icon {{ "tf/channel", msgOutDateFg }};
outChannelBadgeSelectedIcon: icon {{ "tf/channel", msgOutDateFgSelected }};

infoExteraOfficialBadge: icon {{ "profile_verified_star", profileVerifiedCheckBg }};
infoExteraSupporterBadge: icon {{ "profile_verified_star", profileVerifiedCheckBg }};

winEnterWithGuestIcon: icon {{ "tf/ghost_tray", windowFg }};

editedIcon: IconEmoji{
    icon: icon{{ "tf/edited", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

deletedIcon: IconEmoji{
    icon: icon{{ "tf/trash_bin", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

burntIcon: IconEmoji{
    icon: icon{{ "tf/burnt", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

dialogsExteraOfficialIcon: ThreeStateIcon {
	icon: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBg }};
	over: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBgOver }};
	active: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBgActive }};
}
dialogsExteraSupporterIcon: ThreeStateIcon {
	icon: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBg }};
	over: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBgOver }};
	active: icon {{ "dialogs/dialogs_verified_star", dialogsVerifiedIconBgActive }};
}
